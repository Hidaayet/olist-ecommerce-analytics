{
  "name": "Olist Analytics",
  "dataColors": ["#1f4e79", "#d9822b", "#9db4d0", "#b23b3b", "#5b8c5a", "#8a8a8a", "#7b5ea7", "#c9a227"],
  "background": "#ffffff",
  "foreground": "#2b2b2b",
  "tableAccent": "#1f4e79",
  "good": "#5b8c5a",
  "neutral": "#c9a227",
  "bad": "#b23b3b",
  "maximum": "#1f4e79",
  "center": "#9db4d0",
  "minimum": "#eef3f8",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1f4e79" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#2b2b2b" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1f4e79" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1f4e79" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#ffffff" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "title": [{ "fontColor": { "solid": { "color": "#1f4e79" } }, "fontSize": 12 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#f5f7fa" } }, "transparency": 0 }]
      }
    }
  }
}
